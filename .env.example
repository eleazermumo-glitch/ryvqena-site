# ---- Frontend (optional) ----
# Leave empty to use the bundled server at /api/inquiries.
# Set a full URL if the backend is hosted on another domain (then set ALLOWED_ORIGIN on the server).
VITE_FORM_ENDPOINT=

# ---- Server (copy these into the environment where you run `npm run server`) ----
PORT=8787
DATA_DIR=./backend/data
# Required to use /admin. Use a long random value, e.g. `openssl rand -hex 32`.
ADMIN_TOKEN=
# Set to 1 when running behind a proxy/load balancer so rate limiting sees the real visitor IP.
TRUST_PROXY=0
# Only needed if the site and the API are on different domains, e.g. https://ryvqena.tech
ALLOWED_ORIGIN=
# Optional email alerts through Resend (https://resend.com). All three are needed.
RESEND_API_KEY=
MAIL_FROM=Ryvqena Tech <enquiries@your-verified-domain>
NOTIFY_TO=ryvqenatech@gmail.com

# Optional AI chat assistant on the site. Without a key the assistant still answers from built-in facts.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
AGENT_RATE_MAX=20
